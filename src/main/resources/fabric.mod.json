{
  "schemaVersion": 1,
  "id": "core-server-tools",
  "version": "${version}",
  "name": "Core Server Tools",
  "description": "Core server-side utilities: persistent homes, chunk claims, trusts, and visual outlines for Fabric servers.",
  "authors": [
    "BloodyNessa"
  ],
  "contact": {
    "homepage": "https://github.com/BloodyNessa/core-server-tools",
    "sources": "https://github.com/BloodyNessa/core-server-tools"
  },
  "license": "MIT",
  "icon": "assets/core-server-tools/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "nessa.coseto.CoreServerTools"
    ]
  },
  "mixins": [
    "core-server-tools.mixins.json",
    {
      "config": "core-server-tools.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.2",
    "minecraft": "~26.2-",
    "java": ">=25",
    "fabric-api": "*"
  }
}